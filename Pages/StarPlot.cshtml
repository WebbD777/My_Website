@page
@model My_Website.Pages.StarPlotModel
@{
    ViewData["Title"] = "Star Plot";
}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <h1>@ViewData["Title"]</h1>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>
<body>

    <div class="form-check">
        <input class="form-check-input" type="radio" name="exampleRadios" id="exampleRadios1" value="option1" checked>
        <label class="form-check-label" for="exampleRadios1">
            Stable Orbit
        </label>
    </div>
    <div class="form-check">
        <input class="form-check-input" type="radio" name="exampleRadios" id="exampleRadios2" value="option2">
        <label class="form-check-label" for="exampleRadios2">
            Input own orbit
        </label>
    </div>

    <div style="display: flex; justify-content: flex-end;">
        <button type="button" class="btn btn-primary" id="submitBtn">Submit</button>
    </div>

    <label for="exampleFormControlInput1" class="form-label" id="form">Email address</label>

    <canvas id="starChart" width="400" height="200"></canvas>
    <script src="~/js/starScript.js"></script>

</body>

</html>