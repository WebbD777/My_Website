@page
@model My_Website.Pages.PortfolioModel
@{
    ViewData["Title"] = "Portfolio";
}

<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
</head>
<body>
    

    <div class="container">
        <h1>@ViewData["Title"]</h1>
        <div class="projects">

            <div class="Mathematics">
                <h1 class="display-5">Numerical analysis on the Hénon-Heiles model</h1>
                
                <p>Goal is to obtain the orbit of a star, with different initial conditions <br />
                    You can obtain your own plots using the explained method here -> <a class="btn btn-primary" href="starPlot" role="button">Star</a>
                </p>

                <div class="container text-center">
                    <div class="row row-cols-2">
                        <div class="col border border-primary border-2">
                            <p>* First, intigrate the equations of motion using Runge Kutta</p>
                            <figure class="figure">
                                <img src="~/images/portfolio/equationsMotion.png" class="figure-img img-fluid rounded" alt="Image of equations of motion.">
                                <figcaption class="figure-caption">Image of equations of motion.</figcaption>
                            </figure>
                        </div>
                        <div class="col border border-primary border-2">
                            <p>* Second, Since the Energy equation is conserved, it can be used to calculate the error <br /> I don't implement this, I use an iteration limit'
                                <br />
                                An initial energy H0 is  used to calculate the initial value for momentum in x-direction
                                </p>
                            <figure class="figure">
                                <img src="~/images/portfolio/energyStar.png" class="figure-img img-fluid rounded" alt="Image of energy equation.">
                                <figcaption class="figure-caption">Image of energy equation.</figcaption>
                            </figure>
                        </div>
                        <div class="col border border-primary border-2">
                            <p>* Thrid, Equations for the initial conditions, momentum in x-direction is calculated from other intial conditions</p>
                            <figure class="figure">
                                <img src="~/images/portfolio/initialConditions.png" class="figure-img img-fluid rounded" alt="Image of equations for the initial conditions.">
                                <figcaption class="figure-caption">Image of equations for the initial conditions.</figcaption>
                            </figure>
                        </div>
                    </div>
                        <div class="col"></div>
                    </div>
                </div>

                

               

                
            <div class="App">
                <h1 class="display-5">App made in .NET MAUI that uses the API of the national tresuary made avaliable at <a class="link" href="https://municipaldata.treasury.gov.za/" role="button">Tresuary/API/Site</a> to get and display yearly financial data of a chosen municipality</h1>
                <br />
                <p>The first screen is where you choose the municipality whose yearly financial data you want to view, here OR Tambo is picked</p>
                <br></br>
                <p>Link to its github is here  <a class="link" href="https://github.com/WebbD777/tresuaryAPi2/tree/master" role="button">tresuaryApp/Github</a></p>
                <div class="row row-cols-2">
                    
                    <div class="col border border-primary border-2">
                        
                        <figure class="figure">
                            <img src="~/images/portfolio/phoneHome.png" class="figure-img img-fluid rounded" alt="Image of equations of motion.">
                            <figcaption class="figure-caption">Image of 1st home screen.</figcaption>
                        </figure>
                    </div>
                    <div class="col border border-primary border-2">
                        
                        <figure class="figure">
                            <img src="~/images/portfolio/phoneHomeOR.png" class="figure-img img-fluid rounded" alt="Image of energy equation.">
                            <figcaption class="figure-caption">Image of energy equation.</figcaption>
                        </figure>
                    </div>

                    
                    <div class="col border border-primary border-2">
                        <figure class="figure">
                            <img src="~/images/portfolio/phoneDebt.png" class="figure-img img-fluid rounded" alt="Image of equations for the initial conditions.">
                            <figcaption class="figure-caption">Image of chosen municipality.</figcaption>
                        </figure>
                    </div>
                    <div class="col border border-primary border-2">
                        <figure class="figure">
                            <img src="~/images/portfolio/phoneDebtChoose.png" class="figure-img img-fluid rounded" alt="Image of equations for the initial conditions.">
                            <figcaption class="figure-caption">Image of inputted year and chosen financial category.</figcaption>
                        </figure>
                    </div>

                    <div class="col border border-primary border-2">
                        <figure class="figure">
                            <img src="~/images/portfolio/phoneAmount.png" class="figure-img img-fluid rounded" alt="Image of equations for the initial conditions.">
                            <figcaption class="figure-caption">Image of municiaplity's chosen yearly financial data'.</figcaption>
                        </figure>
                    </div>
                </div>
            </div>

            <div class="Game">
                <span class="placeholder col-6"></span>
                <p>Explain The image of TopFarmGame and interesting code bits</p>
            </div>

            

        </div>

    </div>

</body>

</html>

